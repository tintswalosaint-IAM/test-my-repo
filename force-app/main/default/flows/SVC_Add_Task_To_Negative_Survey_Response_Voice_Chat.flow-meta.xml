    <decisions>
        <name>SVC_Check_Negative_Answer</name>
        <label>Check Negative Answer</label>
        <locationX>578</locationX>
        <locationY>455</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SVC_Is_Exists_Negative_Answer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SVC_NegativeAgentRating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_Case_Team_QA_or_Manager_is_set</targetReference>
            </connector>
            <label>Is Exists Negative Answer</label>
        </rules>
    </decisions>
    <description>SFP-9383 Auto launched flow intended to cater for survey responses created through a CTI setup</description>
    <formulas>
        <description>Is the agent rating negative</description>
        <name>SVC_NegativeAgentRating</name>
        <dataType>Boolean</dataType>
        <expression>OR(
       ISPICKVAL({!$Record.SVC_AgentRating__c},&quot;1&quot;),
       ISPICKVAL({!$Record.SVC_AgentRating__c},&quot;2&quot;),
       ISPICKVAL({!$Record.SVC_AgentRating__c},&quot;3&quot;),
       ISPICKVAL({!$Record.SVC_AgentRating__c},&quot;4&quot;),
       ISPICKVAL({!$Record.SVC_AgentRating__c},&quot;5&quot;)
    )</expression>
    </formulas>
    <formulas>
        <name>Task_Subject</name>
        <dataType>String</dataType>
        <expression>&apos;Bad response follow up - &apos; +  {!SVC_GetAssociatedCase.Subject}</expression>
    </formulas>
    <interviewLabel>SVC Add Task To Negative Survey Response (Voice &amp; Chat) {!$Flow.CurrentDateTime}</interviewLabel>
