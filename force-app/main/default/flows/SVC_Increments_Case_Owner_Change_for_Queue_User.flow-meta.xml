<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Increment_number_of_Queue_Owners_on_a_Case</name>
        <label>Increment number of Queue Owners on a Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.SVC_QueueOwnersOnACase__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PopulateNumberOfQueueOwnersOnCase</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Increment_Counter_For_the_Case_Owner_Field_Change</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_number_of_User_Owners_on_a_Case</name>
        <label>Increment number of User Owners on a Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.SVC_UserOwnersOnACase__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PopulateNumberOfUserOwnersOnCase</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Case_Owner_Team</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetCaseAllocationDate</name>
        <label>SetCaseAllocationDate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.SVC_Case_Allocation_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Increment_Counter_For_the_Case_Owner_Field_Change</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Case_Owner</name>
        <label>Check Case Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Queue_is_case_owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increment_number_of_Queue_Owners_on_a_Case</targetReference>
            </connector>
            <label>Queue is case owner</label>
        </rules>
        <rules>
            <name>User_is_case_owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner:User.Id</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increment_number_of_User_Owners_on_a_Case</targetReference>
            </connector>
            <label>User is case owner</label>
        </rules>
    </decisions>
    <decisions>
        <name>isOfTypeComplaintAndPPB</name>
        <label>isOfTypeComplaintAndPPB</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Increment_Counter_For_the_Case_Owner_Field_Change</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SA_Complaints_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Owner_Team.SVC_EnableComplaintsManagement__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Owner_Team.SVC_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PPB</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Owner_Team.CMN_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ZA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetCaseAllocationDate</targetReference>
            </connector>
            <label>SA Complaints Case</label>
        </rules>
    </decisions>
    <description>Count number of Queue / User Owners on a Case for the Track First Touch Resolution process.
SFP-49391 PPB SA: Complaint Logging Notification</description>
    <environments>Default</environments>
    <formulas>
        <description>Count number of Queue Owners on a Case</description>
        <name>PopulateNumberOfQueueOwnersOnCase</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.SVC_QueueOwnersOnACase__c}), 1, {!$Record.SVC_QueueOwnersOnACase__c} + 1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Count number of User owners on a Case</description>
        <name>PopulateNumberOfUserOwnersOnCase</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.SVC_UserOwnersOnACase__c}), 1, {!$Record.SVC_UserOwnersOnACase__c} + 1)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>SVC Increments Case Owner Change for  Queue/User {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SVC Increments Case Owner Change for  Queue/User</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Case_Owner_Team</name>
        <label>Get Case Owner Team</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>isOfTypeComplaintAndPPB</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SVC_CaseOwnerTeam__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CMN_Team__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Increment_Counter_For_the_Case_Owner_Field_Change</name>
        <label>Increment Counter For the Case Owner Field Change</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Case_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
