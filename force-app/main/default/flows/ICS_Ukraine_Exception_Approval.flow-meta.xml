                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Stage_of_the_Opportunity</targetReference>
            </connector>
            <label>Ukraine Exception Declined</label>
        </rules>
    </decisions>
    <description>SFP-34850 Pause Applications
AC2.2 Ukraine Exception option selected
WHEN Ukraine Exception is selected 
THEN I want a &apos;Ukraine Exception Result&apos; picklist field with the following options enabled:
Exception - Approved
Exception - Declined
AND a mandatory  &apos;Comment&apos; free text field enabled

Depends on the Application Form stage = &apos;On hold&apos;, On hold Reason = &apos;Ukraine Exception&apos;
Adds Ukraine Exception Approved; to Required_Approval_Processes__c field</description>
    <environments>Default</environments>
    <formulas>
        <description>Applicant&apos;s Name</description>
        <name>ApplicantName</name>
        <dataType>String</dataType>
        <expression>{!Each_ApplicationForm2.Account.FirstName} + &apos; &apos; + {!Each_ApplicationForm2.Account.LastName}</expression>
    </formulas>
    <formulas>
        <name>jsonString</name>
        <dataType>String</dataType>
        <expression>&apos;{&quot;Approval&quot;: &quot;&apos; + IF({!Ukraine_Exception_Approval}, &apos;Approved&apos;, &apos;Declined&apos;) + &apos;&quot;, &quot;Comment&quot;: &quot;&apos; + {!Comment} + &apos;&quot;, &quot;name&quot;: &quot;Ukraine Exception Approval&quot;, &quot;pId&quot;: &quot;&apos; + {!Each_ApplicationForm2.AccountId} + &apos;&quot;}&apos;</expression>
    </formulas>
    <formulas>
        <description>Get PartyProfile Id from the semicolon separated Opportunity.Required_Approval_Processes__c field to store the document against the PartyProfile record</description>
        <name>PartyProfileIdString</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!recordId.Required_Approval_Processes__c}, &apos;PrimaryPartyProfileId;&apos;), MID({!recordId.Required_Approval_Processes__c}, FIND(&apos;PrimaryPartyProfileId;&apos;, {!recordId.Required_Approval_Processes__c})+22,18), &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <description>Query Assessment Question Response</description>
        <name>QueryAssessmentQuestionResponse</name>
        <dataType>String</dataType>
        <expression>&apos;Assessment(AccountId = :&quot;&apos; + {!Each_ApplicationForm2.AccountId} + &apos;&quot; &amp;&amp; Name = :&quot;Ukraine Exception Approval&quot;).AssessmentQuestionResponse(Sort By LastModifiedDate).AssessmentQuestionVersion.AssessmentQuestion(DeveloperName = :&quot;Comment&quot;).&lt;AssessmentQuestionVersion.&lt;AssessmentQuestionResponse(0)&apos;</expression>
    </formulas>
    <formulas>
        <name>UkraineStringApprovedAppended</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!recordId.Required_Approval_Processes__c}, &apos;Ukraine Exception Approved;&apos;), {!recordId.Required_Approval_Processes__c}, {!recordId.Required_Approval_Processes__c} + &apos;Ukraine Exception Approved;&apos;)</expression>
    </formulas>
