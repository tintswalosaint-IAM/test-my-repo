    <decisions>
        <description>Determines whether the Ukraine Exception approval was accepted or declined based on user input and updates the opportunity field accordingly</description>
        <name>Verify_Ukraine_Exception_Approval_Status</name>
        <label>Verify Ukraine Exception Approval Status</label>
        <locationX>578</locationX>
        <locationY>2054</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Ukraine_Exception_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isDeclined</leftValueReference>
                <operator>EqualTo</operator>
