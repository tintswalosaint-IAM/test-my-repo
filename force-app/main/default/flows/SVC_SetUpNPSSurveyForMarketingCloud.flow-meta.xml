        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Resolve_Domain_Excluded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Ins_Domain_Exclusion_Result</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SVC_CaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>SVC_SendSurveyIndicator</elementReference>
                </rightValue>
            </conditions>
