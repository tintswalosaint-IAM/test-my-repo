        <rules>
            <name>Is_Case_Status_Resolved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SVC_CaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>SVC_SendSurveyIndicator</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SVC_Create_Survey_Details</targetReference>
            </connector>
            <label>Is Case Status Resolved</label>
        </rules>
