    <assignments>
        <name>SVC_IncrementIncomingEmails</name>
        <label>Increment Incoming Emails</label>
        <locationX>50</locationX>
        <locationY>621</locationY>
        <assignmentItems>
            <assignToReference>SVC_GetCase.SVC_IncomingEmails__c</assignToReference>
            <operator>Assign</operator>
