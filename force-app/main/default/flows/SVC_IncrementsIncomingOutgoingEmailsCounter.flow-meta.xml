            <targetReference>SVC_IncrementCounter</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>SVC_FilterEmail</name>
        <label>Filter Email</label>
        <locationX>221</locationX>
        <locationY>463</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SVC_IncomingEmail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Incoming</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>0</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SVC_IncrementIncomingEmails</targetReference>
            </connector>
            <label>Incoming Email</label>
        </rules>
        <rules>
            <name>SVC_OutgoingEmail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>3</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SVC_IncrementOutgoingEmails</targetReference>
            </connector>
            <label>Outgoing Email</label>
        </rules>
    </decisions>
    <description>SFP-4616 - Increments the field # Incoming Emails when a new email is received to a case from a customer OR the field # Outgoing Emails when a new email is sent from a case to a customer</description>
    <formulas>
        <name>SVC_PopulateIncomingEmails</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!SVC_GetCase.SVC_IncomingEmails__c}), 1, {!SVC_GetCase.SVC_IncomingEmails__c} + 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>SVC_PopulateOutgoingEmails</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!SVC_GetCase.SVC_OutgoingEmails__c}), 1, {!SVC_GetCase.SVC_OutgoingEmails__c} + 1)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>SVC Increments Incoming/ Emails Counter {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SVC Increments Incoming/Outgoing Emails Counter</label>
