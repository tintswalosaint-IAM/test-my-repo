    </decisions>
    <decisions>
        <name>SVC_IsCaseResolved</name>
        <label>Is Case Resolved</label>
        <locationX>182</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Is_Resolved</name>
            <conditionLogic>(1 AND 3) AND (2 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resolved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.Case_Owner_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ZA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Incoming</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.SVC_ServiceTeam__r.CMN_Team__r.SVC_Reopen_Resolved_Case__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SVC_UpdateCaseDetails</targetReference>
            </connector>
            <label>Case Is Resolved</label>
        </rules>
        <rules>
            <name>Case_Is_Unresolved</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Unresolved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Incoming</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.SVC_ServiceTeam__r.CMN_Team__r.SVC_Reopen_Unresolved_Case__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CreatedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>SVC_VAR_CreateNewCaseDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.SVC_ServiceTeam__r.CMN_Team__r.SVC_CreateNewCaseAfterHours__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SVC_UpdateCaseDetails</targetReference>
            </connector>
            <label>Case Is Unresolved</label>
        </rules>
    </decisions>
    <description>SFP-3047: Reopen a closed case when a new inbound email is received
Addition of dynamic check for reopening cases.
Error handeling.
SFP-43644 - Reopen Unresolved cases
SFP-47902 - RIM Cases not reopening.
SFP-51598 - Send email alerts the previous case owner when the case reopens.
SFP-53314 - Reopen Cases based on the Reopen Resolved Case checkbox</description>
    <environments>Default</environments>
    <formulas>
        <name>SVC_VAR_CreateNewCaseDate</name>
        <dataType>DateTime</dataType>
        <expression>({!$Record.Parent.ClosedDate} + ({!$Record.Parent.SVC_ServiceTeam__r.CMN_Team__r.SVC_CreateNewCaseAfterHours__c})/24)</expression>
