    <description>SFP-30018[C] Flow to update external identifier code.</description>
    <environments>Default</environments>
    <formulas>
        <name>CheckExternalCountryField</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(Text({!$Record.ExternalCountry__c})),
Text({!$User.User_Country__c}),
Text({!$Record.ExternalCountry__c}))</expression>
    </formulas>
