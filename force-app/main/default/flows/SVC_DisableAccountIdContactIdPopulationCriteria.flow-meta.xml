    <formulas>
        <name>varF_Filter</name>
        <dataType>String</dataType>
        <expression>TRIM(SUBSTITUTE(LEFT({!varT_FilterText}, FIND(&apos;;&apos;, {!varT_FilterText}) - {!count}),&apos;;&apos; , &apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>varF_LastFilterTextCharacter</name>
        <dataType>String</dataType>
        <expression>RIGHT({!varT_FilterText}, 1)</expression>
    </formulas>
    <formulas>
        <name>varN_NumberOfFilters</name>
        <dataType>Number</dataType>
        <expression>LEN({!varT_FilterText}) - LEN(SUBSTITUTE({!varT_FilterText}, &apos;;&apos;, &apos;&apos;))</expression>
        <scale>0</scale>
    </formulas>
