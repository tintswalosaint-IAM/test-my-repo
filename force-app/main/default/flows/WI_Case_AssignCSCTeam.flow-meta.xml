    FIND(&quot;You can look up ExceptionCode&quot;, {!$Flow.FaultMessage}) - FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION:&quot;, {!$Flow.FaultMessage}) - 34
)</expression>
