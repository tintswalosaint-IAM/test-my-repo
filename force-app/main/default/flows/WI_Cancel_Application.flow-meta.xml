        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YesReport</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>getApplicationDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>getClientEngagementReport.DeveloperName</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getApplicationDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>getClientEngagementReportAddendum.DeveloperName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>App_Cancellation</targetReference>
            </connector>
            <label>Yes Report</label>
        </rules>
    </decisions>
