    <textTemplates>
        <name>email_body</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&amp;lt;img src=&quot;https://standardbankgroupltd--chnwsbfdev--c.sandbox.vf.force.com/resource/1755681841000/SBFC_Email_Header&quot;/&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;Dear {!Get_Lead_SBFC_Lead.Name},&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;Thank you for choosing Standard Bank Financial Consultancy (SBFC) to support your financial journey.&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;We are pleased to confirm your upcoming appointment with &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!Get_Lead_SBFC_Lead.OwnerId}&lt;/span&gt; .&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;Date: {!$Record.ActivityDate}&lt;/p&gt;&lt;p&gt; &amp;lt;br/&amp;gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;Time: {!$Record.ActivityDateTime}&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;nbsp;&amp;lt;br/&amp;gt;&amp;lt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Location: {!Get_Lead_SBFC_Lead.PreferredContactMethod__c} &amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The purpose of the appointment is to focus on your financial goals and explore strategies tailored to your needs, whether you are planning for retirement, managing investments or building long-term financial security.&amp;nbsp;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To help us make the most of our time together, please bring along any relevant documents or questions you would like to discuss.&amp;nbsp;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;A Disclosure Form has been sent to your email through SigningHub. Kindly review and sign it before our meeting.&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;If you need to reschedule or update any details before the meeting, feel free to reach out and we will gladly assist you.&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;We look forward to connecting with you and supporting your financial success.&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;Kind regards&amp;nbsp;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;Standard Bank Financial Consultancy&amp;nbsp;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;SBFC Contact Centre&amp;nbsp;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;086 003 4778&amp;nbsp;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;lt;img src=&quot;https://standardbankgroupltd--chnwsbfdev--c.sandbox.vf.force.com/resource/1755692763000/sbfc_disclaimer?&quot;/&amp;gt;&lt;/p&gt;</text>
