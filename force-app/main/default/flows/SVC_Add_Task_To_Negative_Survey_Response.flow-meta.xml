    <decisions>
        <name>Check_Type_of_Question</name>
        <label>Check Type of Question</label>
        <locationX>2844</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>For_Each_Survey_Question</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Angola_Negative_Responses</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>For_Each_Survey_Question.Question.QuestionName</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>How likely are you to recommend Standard Bank Angola to a friend or colleague?</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>For_Each_Survey_Question.NumberValue</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>6.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>For_Each_Survey_Question.NumberValue</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Negative_Answer</targetReference>
            </connector>
            <label>Angola Negative Responses</label>
        </rules>
    </decisions>
