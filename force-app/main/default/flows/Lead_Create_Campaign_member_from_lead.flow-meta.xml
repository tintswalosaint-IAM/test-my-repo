    <description>SFP-48665 - Updated to create a Campaign Member based on the Campaign Source ID from the Lead record and depending on whether it is during business or non-business hours.</description>
    <environments>Default</environments>
    <formulas>
        <description>Formula to return the name of the associated Campaign.</description>
        <name>CampaignName</name>
        <dataType>String</dataType>
        <expression>IF({!CheckBusiness_Hours}, &apos;INS_CRTSY_BUSHR_SMS&apos;, &apos;INS_CRTSY_NONBUSHR_SMS&apos;)</expression>
    </formulas>
    <formulas>
        <name>CheckBusiness_Hours</name>
        <dataType>Boolean</dataType>
        <expression>AND(

  MOD({!$Record.CreatedDate} + (2/24) - DATETIMEVALUE(DATEVALUE({!$Record.CreatedDate} + (2/24))), 1) &gt;= (7/24),
  MOD({!$Record.CreatedDate} + (2/24) - DATETIMEVALUE(DATEVALUE({!$Record.CreatedDate} + (2/24))), 1) &lt;= (16.5/24),


  WEEKDAY(DATEVALUE({!$Record.CreatedDate} + (2/24))) &gt;= 2,
  WEEKDAY(DATEVALUE({!$Record.CreatedDate} + (2/24))) &lt;= 6,

 
  NOT(
    CONTAINS(
      &quot;01-01;03-21;04-27;05-01;06-16;08-09;09-24;12-16;12-25;12-26&quot;,
      TEXT(MONTH(DATEVALUE({!$Record.CreatedDate} + (2/24)))) &amp; &quot;-&quot; &amp;
      LPAD(TEXT(DAY(DATEVALUE({!$Record.CreatedDate} + (2/24)))), 2, &quot;0&quot;)
    )
  )
)</expression>
    </formulas>
    <formulas>
        <description>Formula to format the mobile number into a standardized format.</description>
        <name>ConvertedMobileNumber</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(BEGINS(TEXT({!$Record.Mobile_Phone_With_Country_Code__c}), &quot;27&quot;)),
  &quot;27&quot; &amp; TEXT({!$Record.Mobile_Phone_With_Country_Code__c}),
  TEXT({!$Record.Mobile_Phone_With_Country_Code__c})
)</expression>
    </formulas>
    <formulas>
        <description>This formula holds the id of the createdby user of the lead.</description>
        <name>leadCreator</name>
        <dataType>String</dataType>
        <expression>{!$Record.CreatedById}</expression>
    </formulas>
    <formulas>
        <name>LeadFullName</name>
        <dataType>String</dataType>
        <expression>{!$Record.FirstName}&amp;&apos; &apos;&amp;{!$Record.LastName}</expression>
    </formulas>
