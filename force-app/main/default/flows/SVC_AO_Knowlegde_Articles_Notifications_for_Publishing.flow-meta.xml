<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Get_hyperlink</name>
        <label>Get hyperlink</label>
        <locationX>1049</locationX>
        <locationY>400</locationY>
        <actionName>getArticleSmartLinkUrl</actionName>
        <actionType>getArticleSmartLinkUrl</actionType>
        <connector>
            <targetReference>New_Article_Published</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>articleVersionId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>getArticleSmartLinkUrl</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>New_Article_Published</name>
        <label>New Article Published</label>
        <locationX>1213</locationX>
        <locationY>400</locationY>
        <actionName>chatterPost</actionName>
        <actionType>chatterPost</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>text</name>
            <value>
                <elementReference>Link</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>subjectNameOrId</name>
            <value>
                <elementReference>Get_all_Users.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>chatterPost</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check the Status</description>
        <name>Article_Status</name>
        <label>Article Status</label>
        <locationX>847</locationX>
        <locationY>404</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Published</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SVC_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.SVC_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FirstPublishedDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_hyperlink</targetReference>
            </connector>
            <label>Is Published</label>
        </rules>
        <rules>
            <name>Is_Archived</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SVC_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.SVC_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <label>Is Archived</label>
        </rules>
    </decisions>
    <description>SFP-12194 - As a Service Agent Banker from Angola I want to be notified whenever a new article is Published</description>
    <formulas>
        <name>Link</name>
        <dataType>String</dataType>
        <expression>&apos;Artigo &quot;&apos; + {!$Record.Title} + &apos;&quot; foi publicado e está disponivel para consulta neste link: &apos; + {!Get_hyperlink.articleSmartLinkUrl}</expression>
    </formulas>
    <interviewLabel>SVC AO Knowlegde Articles Notifications for Publishing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SVC AO Knowlegde Articles Notifications for Publishing</label>
    <processMetadataValues>
