<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Log errors for all the fault paths in current flow</description>
        <name>Write_Error_Log</name>
        <label>Write Error Log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>CMN_DAL_Logger</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>messages</name>
            <value>
                <elementReference>ErrorLogMessage</elementReference>
            </value>
        </inputParameters>
        <nameSegment>CMN_DAL_Logger</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <description>Store flow name</description>
        <name>FlowInterviewLabel</name>
        <dataType>String</dataType>
        <value>
            <stringValue>AOB_PPB_Link_ChatCase_To_Lead</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Checks if created case record has Chat case recordtype</description>
        <name>Check_if_Case_has_Chat_Case_Recordtype</name>
        <label>Check if Case has Chat Case Recordtype</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other Case</defaultConnectorLabel>
        <rules>
            <name>Chat_case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_CMDT_Chat_Case_RecordType.value__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Matching_Leads_with_Case_Email</targetReference>
            </connector>
            <label>Chat case</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if we have any matching leads with same email of created case email</description>
        <name>Check_if_we_have_any_Leads_with_case_email</name>
        <label>Check if we have any Leads with case email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No lead exist with case email</defaultConnectorLabel>
        <rules>
            <name>Lead_exist_with_matching_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matching_Leads_with_Case_Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LeadIds</targetReference>
            </connector>
            <label>Lead exist with matching Email</label>
        </rules>
    </decisions>
    <description>Links case record that is created from offline chat on product site with Matching Lead Record</description>
    <environments>Default</environments>
    <formulas>
        <description>Ensure error logging has enough context (Case.Id, SuppliedEmail, Flow.InterviewLabel)</description>
        <name>ErrorLogMessage</name>
        <dataType>String</dataType>
        <expression>{!FlowInterviewLabel} &amp; &apos; | Case Id: &apos; &amp; $Record.Id &amp; &apos; | Email: &apos; &amp; $Record.SuppliedEmail &amp; &apos; | Fault: &apos; &amp; $Flow.FaultMessage</expression>
    </formulas>
    <interviewLabel>AOB_PPB_Link_ChatCase_To_Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AOB_PPB_Link_ChatCase_To_Lead</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get Chat case Recordtype Value using Developer name from Custom metadata</description>
        <name>Get_CMDT_Chat_Case_RecordType</name>
        <label>Get CMDT Chat Case RecordType</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Case_has_Chat_Case_Recordtype</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Write_Error_Log</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Chat_Case_RecordType</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PPB_Static_values__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>value__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Getting matching application records with filtering condition of Lead.Email equals case email and Producttype.name equals case product type value</description>
        <name>Get_Matching_Applications</name>
        <label>Get Matching Applications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Link_Case_with_Matching_Lead</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Write_Error_Log</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AOB_Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RelatedProduct.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AOB_Lead__c</field>
            <operator>In</operator>
            <value>
                <elementReference>LeadIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Application__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AOB_Lead__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get matching lead record with case supplied email field to link with each other</description>
        <name>Get_Matching_Leads_with_Case_Email</name>
        <label>Get Matching Leads with Case Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_we_have_any_Leads_with_case_email</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Write_Error_Log</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SuppliedEmail</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>RelatedProduct</name>
        <label>Related Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Matching_Applications</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Write_Error_Log</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Description</elementReference>
            </value>
        </filters>
        <filters>
            <field>Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>UG</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Product2</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>update the lead lookup field on the case record with matching lead record id</description>
        <name>Link_Case_with_Matching_Lead</name>
        <label>Link Case with Matching Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Write_Error_Log</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Lead__c</field>
            <value>
                <elementReference>Get_Matching_Applications.AOB_Lead__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CMDT_Chat_Case_RecordType</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <transforms>
        <name>LeadIds</name>
        <label>Lead Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>RelatedProduct</targetReference>
        </connector>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <transformType>Map</transformType>
                <value>
                    <elementReference>Get_Matching_Leads_with_Case_Email[$EachItem].Id</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <variables>
        <name>apptest</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Application__c</objectType>
    </variables>
    <variables>
        <name>toBeUpdatedCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
</Flow>
