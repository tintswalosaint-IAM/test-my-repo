    <decisions>
        <description>Check if the Account is a staff account based on the Marketing segment or Branch Code</description>
        <name>Is_Staff_Values_Changed</name>
        <label>Is Staff Values Changed</label>
        <locationX>380</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Branch_Unit</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Add_Staff</name>
            <conditionLogic>3 AND ((1 AND 4 ) OR (2 AND 5) OR (1 AND 6) OR (2 AND 6) OR (7 AND 8 AND (9 OR 10)) )</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FinServ__MarketingSegment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Staff</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FinServ__BranchName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Staff Branch</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ExternalCIFCountry__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AO</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FinServ__MarketingSegment__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FinServ__BranchName__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Staff_Indicator__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FinServ__BranchName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Staff Branch</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FinServ__MarketingSegment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Staff</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Staff_Indicator_in_Account</targetReference>
            </connector>
            <label>Add Staff</label>
        </rules>
        <rules>
            <name>Remove_Staff</name>
            <conditionLogic>5 AND ((1 AND 3 AND 4) OR (2 AND 3 AND 4))</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.FinServ__MarketingSegment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Staff</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.FinServ__BranchName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Staff Branch</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FinServ__MarketingSegment__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Staff</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FinServ__BranchName__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Staff Branch</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ExternalCIFCountry__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Staff_Indicator_in_Account</targetReference>
            </connector>
            <label>Remove Staff</label>
        </rules>
    </decisions>
    <description>This Flow links Accounts to their most up to date Branch Unit
SFP-16382 - Staff Account Visibility	
SFP-15714 - Auto Populate Life Event Birth
SFP-18263 - GH Birth Event creation</description>
    <environments>Default</environments>
    <formulas>
        <description>SFP-18263 Provides the right name depending on country</description>
        <name>BirthEventName</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.ExternalCIFCountry__c}, &apos;GH&apos;), &apos;Birth&apos;, &apos;Aniversário&apos;)</expression>
    </formulas>
    <formulas>
        <name>isNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
