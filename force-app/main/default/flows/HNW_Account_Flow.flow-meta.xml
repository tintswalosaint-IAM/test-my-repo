                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ExternalCIFCountry__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>GH</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Life_Events</targetReference>
            </connector>
