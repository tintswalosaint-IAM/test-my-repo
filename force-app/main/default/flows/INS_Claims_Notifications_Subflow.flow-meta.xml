    <decisions>
        <name>Is_LS_Error_Notification_or_Not</name>
        <label>Is LS Error Notification or Not</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Send_LS_Notification</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is Not Error</defaultConnectorLabel>
        <rules>
            <name>Is_Error_LS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_BOO_IsError</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_LS_Error_Notification</targetReference>
            </connector>
            <label>Is Error</label>
        </rules>
    </decisions>
