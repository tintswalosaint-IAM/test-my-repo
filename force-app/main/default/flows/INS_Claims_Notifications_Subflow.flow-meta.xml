    <textTemplates>
        <name>VAR_TT_EmailErrorSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>New Funeral Claim submitted but encountered errors: {!VAR_IN_ClaimNumber}</text>
    </textTemplates>
    <textTemplates>
        <name>VAR_TT_EmailErrorTemplate</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Dear Team,
Please note there was an error on the claim submission. 
ERROR MESSAGE: {!VAR_IN_ErrorMessage}
Policy Number: {!VAR_IN_PolicyNumber}
Link: {!FOR_Path_PolicyRecordId}
Please access the claim directly from Salesforce using the Policy number reflected above to finalise the claim</text>
    </textTemplates>
    <textTemplates>
