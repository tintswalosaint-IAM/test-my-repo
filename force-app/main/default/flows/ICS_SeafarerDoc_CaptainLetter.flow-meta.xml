    <formulas>
        <name>CLConfirmed</name>
        <dataType>String</dataType>
        <expression>{!recordId.Required_Approval_Processes__c} +&apos;All Done&apos;</expression>
    </formulas>
    <formulas>
        <name>FAISResponseValue</name>
        <dataType>String</dataType>
        <expression>IF({!Captain_Letter_Approval} = true, &apos;Confirm&apos;, &apos;Reject&apos;)</expression>
    </formulas>
    <formulas>
        <name>FAISStringConfirmedAppended</name>
        <dataType>String</dataType>
        <expression>{!recordId.Required_Approval_Processes__c} + &apos;Captain Letter Approval Confirmed;&apos;+{!PartyProfile.AccountId}</expression>
    </formulas>
    <formulas>
        <name>FAISStringRejectedAppended</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!recordId.Required_Approval_Processes__c}, &apos;FAIS Approval Rejected;&apos;), {!recordId.Required_Approval_Processes__c}, {!recordId.Required_Approval_Processes__c} + &apos;FAIS Approval Rejected;&apos;)</expression>
    </formulas>
    <formulas>
        <description>Construct formatted document name
Firstname-Surname-DocumentType-DocumentDate</description>
        <name>FormattedName</name>
        <dataType>String</dataType>
        <expression>{!PartyProfile.Account.FirstName} + &apos;-&apos; + {!PartyProfile.Account.LastName}+ &apos;-&apos; + &apos;Captain Letter&apos; + &apos;-&apos; + TEXT(TODAY())</expression>
    </formulas>
    <formulas>
        <name>Incrementor</name>
        <dataType>Number</dataType>
        <expression>{!Counter}+1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>NotRequired</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!recordId.Required_Approval_Processes__c}, &apos;Need Captain letter Approval;&apos;)</expression>
    </formulas>
