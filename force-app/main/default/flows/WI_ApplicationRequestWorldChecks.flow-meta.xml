            </connector>
            <label>Person</label>
        </rules>
    </decisions>
    <description>SFP-20429 - Client Engagement Report | World checks notification email
SFP-40947 - CRA check buttons must not be the creator of party screening fields.
SFP-50319 -  Intermittent email notifications delivery issues, running context of the flow altered to minimize issues.
SFP-50491 - Change the email template sent to due deligence team to reference &quot;Media check&quot; instead of &quot;World Check&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>email</name>
        <dataType>String</dataType>
        <expression>{!$Setup.WI_Settings__c.WI_WorldChecksNotificationEmail__c} +&apos;,&apos;+ {!$User.Email}</expression>
    </formulas>
    <formulas>
        <description>Formula to obtain WI_IdentityType__c picklist label instead of API</description>
        <name>IdTypePicklistLabel</name>
        <dataType>String</dataType>
        <expression>CASE( TEXT( {!recordId.WI_IdentityType__c} ),
&apos;1&apos;, &apos;National Identity Document&apos;, 
&apos;6&apos;, &apos;Passport Number&apos;,
&apos;20&apos;, &apos;Refugee Permit Document&apos;,
&apos;2&apos;, &apos;Identity Card&apos;,
&apos;10&apos;, &apos;Enterprise Registration Number&apos;,
&apos;11&apos;, &apos;Enterprise Identity Number&apos;, 
&apos;21&apos;, &apos;Asylum Seeker Permit Document&apos;,
&apos;22&apos;, &apos;Voters Id Card&apos;,
&apos;98&apos;, &apos;Id Number Not Available/Not Applicable&apos;,
&apos;Other&apos;)</expression>
    </formulas>
