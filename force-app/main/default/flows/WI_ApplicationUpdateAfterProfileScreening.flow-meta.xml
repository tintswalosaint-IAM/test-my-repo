    <environments>Default</environments>
    <formulas>
        <name>CalculatedAdverseRatingFormula</name>
        <dataType>String</dataType>
        <expression>IF ( OR ({!CreditBureauChecks} = &apos;Adverse&apos;,{!SanctionScreening} = &apos;Sanctioned&apos;,{!WorldCheck} = &apos;Adverse&apos;,
{!MediaAndGoogleSearch} = &apos;Adverse&apos;,{!InvestigationsOrLocalLawEnforcement} = &apos;Yes&apos;), &apos;Adverse&apos;, &apos;Non Adverse&apos;)</expression>
    </formulas>
    <formulas>
        <name>CalculatedRiskRatingFormula</name>
        <dataType>String</dataType>
        <expression>IF(OR({!CreditBureauChecks} &lt;&gt;&apos;Clear&apos;,{!PIPFPPO} &lt;&gt; &apos;Clear&apos;, {!SanctionScreening} &lt;&gt;&apos;Clear&apos;,{!WorldCheck} &lt;&gt;&apos;Clear&apos;,{!MediaAndGoogleSearch}&lt;&gt; &apos;Clear&apos;, {!InvestigationsOrLocalLawEnforcement}&lt;&gt; &apos;No&apos;, {!creditRiskAssessment} = &apos;High&apos;),  &apos;High Risk&apos;, IF(AND({!CreditBureauChecks} = &apos;Clear&apos;, {!PIPFPPO}= &apos;Clear&apos;, {!SanctionScreening}= &apos;Clear&apos;, {!WorldCheck}= &apos;Clear&apos;, {!MediaAndGoogleSearch} = &apos;Clear&apos;), &apos;Medium Risk&apos; , &apos;Low Risk&apos;))</expression>
    </formulas>
    <formulas>
        <name>WealthOnlyAdverseRatingFormula</name>
        <dataType>String</dataType>
        <expression>IF (OR({!SanctionScreening} = &apos;Sanctioned&apos;, {!WorldCheck} = &apos;Adverse&apos;,
{!MediaAndGoogleSearch} = &apos;Adverse&apos; ,{!InvestigationsOrLocalLawEnforcement} = &apos;Yes&apos;), &apos;Adverse&apos;, &apos;Non Adverse&apos;)</expression>
    </formulas>
    <formulas>
