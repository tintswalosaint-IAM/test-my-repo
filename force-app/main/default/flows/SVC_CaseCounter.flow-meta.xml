    <decisions>
        <name>Is_Account_Id_Null</name>
        <label>Is Account Id Null?</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>With_AccountId</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccountID.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Cases</targetReference>
            </connector>
            <label>With AccountId</label>
        </rules>
        <rules>
            <name>Without_Account_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccountID.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Default_Number_Of_Cases</targetReference>
            </connector>
            <label>Without Account Id</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
