    <formulas>
        <name>applicationProcessName</name>
        <dataType>String</dataType>
        <expression>IF( TEXT({!recordId.WI_ProcessType__c}) == &apos;Wealth &amp; Investment&apos;, &apos;WI_HighRiskApplicationApprovalV4&apos;, &apos;WI_WealthOnlyApplication&apos;)</expression>
    </formulas>
    <formulas>
        <name>groupDeveloperName</name>
        <dataType>String</dataType>
        <expression>IF( TEXT({!recordId.WI_RMOverallRiskProfile__c}) == &apos;High Risk&apos;  || TEXT({!recordId.WI_RMAdverseRating__c}) == &apos;Adverse&apos;, &apos;WI_RegionalHead&apos;, &apos;WI_RM_AM_Application_Approvers&apos;)</expression>
    </formulas>
    <formulas>
        <name>userIdPrefixCheck</name>
        <dataType>String</dataType>
        <expression>IF(LEFT({!Loop_members.UserOrGroupId}, 3) == &apos;005&apos;, &apos;005&apos;, &apos;&apos;)</expression>
    </formulas>
