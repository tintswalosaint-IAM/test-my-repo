<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Branch_Manager_Changed</name>
        <label>Branch Manager Changed?</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Changed_Branch_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.BranchManagerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.BranchManagerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Branch_Manager_Id</targetReference>
            </connector>
            <label>Changed Branch Manager</label>
        </rules>
    </decisions>
    <description>SFP-13367: This Flow to update the  RM_Visibility_Indicator__c</description>
    <environments>Default</environments>
    <formulas>
        <name>branchManagerId</name>
        <dataType>String</dataType>
        <expression>TRIM(LEFT({!$Record.BranchManager.UserOrContactId}, (LEN({!$Record.BranchManager.UserOrContactId}) - 3)))</expression>
    </formulas>
    <interviewLabel>HNW Branch Unit Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HNW Branch Unit Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Assign_Branch_Manager_Id</name>
        <label>Assign Branch Manager Id</label>
        <locationX>50</locationX>
        <locationY>455</locationY>
        <inputAssignments>
            <field>Branch_Unit_Manager_Id__c</field>
            <value>
                <elementReference>branchManagerId</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Branch_Manager_Changed</targetReference>
        </connector>
        <filterLogic>(1 OR 4) AND (2 OR 3)</filterLogic>
        <filters>
            <field>External_CIF_Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>AO</stringValue>
            </value>
        </filters>
        <filters>
            <field>BranchManagerId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>BranchCode</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>External_CIF_Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>GH</stringValue>
            </value>
        </filters>
        <object>BranchUnit</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
