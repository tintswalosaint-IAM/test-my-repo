        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Prestige_Queue</targetReference>
        </connector>
        <filterFormula>AND ({!$Record.RecordType.DeveloperName} = &apos;ZA_A_E_Cross_Sell&apos;, {!$Record.CreatedBy.Profile.Name} &lt;&gt; &apos;SVC Agent Banker&apos;)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
