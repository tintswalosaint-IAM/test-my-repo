<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Which Queue to assign the A&amp;E leads based on income amount</description>
        <name>Income_amount</name>
        <label>Income amount</label>
        <locationX>446</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Income_less_than_57499</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Loan_Income_Amount__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>57499.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Loan_Income_Amount__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>25000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Queue_to_prestige</targetReference>
            </connector>
            <label>Income less than 57499</label>
        </rules>
        <rules>
            <name>Income_Greater_than_57500</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Loan_Income_Amount__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>57500.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_queue_to_private</targetReference>
            </connector>
            <label>Income Greater than 57500</label>
        </rules>
        <rules>
            <name>Income_less_than_25000</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Loan_Income_Amount__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>25000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Records_1</targetReference>
            </connector>
            <label>Income less than 25000</label>
        </rules>
    </decisions>
    <description>If an A&amp;E lead has an income amount of less than 25000, it cannot be used for the cross sell process</description>
    <environments>Default</environments>
    <interviewLabel>AE Unqualify Leads on income amount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AE Lead Queue assignment and unqualify leads</label>
    <processMetadataValues>
