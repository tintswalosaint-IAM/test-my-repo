    <description>SFP-34698 Application Approval flow, Queues and Sign off
Subflow to trigger the next expected approval request. It handles the assignment of approvers, updates the Opportunity record, and sends notifications to the relevant users.</description>
    <environments>Default</environments>
    <formulas>
        <description>A text formula variable that will indicate by which Group the request is expected to be approved, will be used to set as comment in the approval request as well as set the body of the notification to the expected approver</description>
        <name>Comments</name>
        <dataType>String</dataType>
        <expression>&apos;To be approved by &apos; + {!GetFullFormOfApproverGroup}</expression>
    </formulas>
    <formulas>
        <description>Retrieve existing Opportunity.Required_Approval_Processes__c field value and replace the ending $ character with the (period plus) expected next approver group code (plus $) to indicate that an approval request for the expected next approver group is to be triggered</description>
        <name>GetDollarReplacedNextApproverGroupCode</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!OpportunityRecordFromParentFlow.Required_Approval_Processes__c}, &apos;$&apos;, &apos;.&apos; + {!ApproverGroupCodeFromParentFlow} +&apos;$&apos;)</expression>
    </formulas>
    <formulas>
        <description>Get the full form of the approver group</description>
        <name>GetFullFormOfApproverGroup</name>
        <dataType>String</dataType>
        <expression>IF(FIND(&apos;;&apos; + {!ApproverGroupCodeFromParentFlow} + &apos;:&apos;, {!FullFormOfApproverGroupCode})!=0, MID({!FullFormOfApproverGroupCode}, FIND(&apos;;&apos; + {!ApproverGroupCodeFromParentFlow} + &apos;:&apos;, {!FullFormOfApproverGroupCode})+4, FIND(&apos;;&apos;, {!FullFormOfApproverGroupCode}, FIND(&apos;;&apos; + {!ApproverGroupCodeFromParentFlow} + &apos;:&apos;, {!FullFormOfApproverGroupCode})+5)-FIND(&apos;;&apos; + {!ApproverGroupCodeFromParentFlow} + &apos;:&apos;, {!FullFormOfApproverGroupCode})-4), &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <description>Frame the developer name from the full form of the group name that was in turn looked up using the two letter Group code</description>
        <name>GroupDeveloperName</name>
        <dataType>String</dataType>
        <expression>&apos;ICS_UK_&apos;+SUBSTITUTE({!GetFullFormOfApproverGroup}, &apos; &apos;, &apos;_&apos;)</expression>
    </formulas>
    <formulas>
        <description>Body of the notification to indicate to the user how he can navigate to the approval request</description>
        <name>NotificationBody</name>
        <dataType>String</dataType>
        <expression>{!Comments} + &apos;\nTo view, click on this notification&apos;</expression>
    </formulas>
