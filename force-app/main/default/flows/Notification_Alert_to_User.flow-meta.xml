    <decisions>
        <description>Checking if the new lead owner assignee is active</description>
        <name>Is_Lead_Owner_Assignee_Active</name>
        <label>Is Lead Owner Assignee Active</label>
        <locationX>710</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No, User is Inactive</defaultConnectorLabel>
        <rules>
            <name>Yes_is_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_of_Notification_Recipients</targetReference>
            </connector>
            <label>Yes, is Active</label>
        </rules>
    </decisions>
    <description>SFP-55219 - Updated the flow and removed the senderID when sending notification to the new Owner.
