    <description>SFP-21107 - CER | CRA Email Notification
SFP-39330 - CRA checks to execute in System Mode to mitigate the duplication of party screening summary created for an application.
SFP-40947 - CRA check buttons must not be the creator of party screening fields.</description>
    <environments>Default</environments>
    <formulas>
        <name>AMRMisEmpty</name>
        <dataType>Boolean</dataType>
        <expression>IF( OR(ISBLANK({!recordId.WI_RelationshipManager__c}),ISBLANK({!recordId.WI_AccountManager__c})),true,false)</expression>
    </formulas>
    <formulas>
        <name>email</name>
        <dataType>String</dataType>
        <expression>{!$Setup.WI_Settings__c.WI_CRAChecksNotificationEmail__c} +&apos;,&apos;+{!$User.Email}</expression>
    </formulas>
