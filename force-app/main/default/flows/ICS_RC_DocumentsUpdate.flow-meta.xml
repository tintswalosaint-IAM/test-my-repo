    <decisions>
        <description>Used to check developer name</description>
        <name>Is_Party_Profile</name>
        <label>Is Party Profile</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>False</defaultConnectorLabel>
        <rules>
            <name>True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PartyProfile.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ICS_PartyProfile</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <description>Automatically fetches RelyComply CRA Report documents when risk category is rerated on PartyProfileRisk record</description>
    <environments>Default</environments>
    <interviewLabel>ICS_RC_DocumentsUpdate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ICS_RC_DocumentsUpdate</label>
