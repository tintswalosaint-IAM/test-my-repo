    <decisions>
        <description>Checks whether FAIS approval is required based on the Opportunity Owner&apos;s country, Party Profile&apos;s country, and specific values in the Required_Approval_Processes__c field on the Opportunity.</description>
        <name>Is_FAIS_Approval_Required</name>
        <label>Is FAIS Approval Required?</label>
        <locationX>710</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YesFAISNeeded</name>
            <conditionLogic>(1 OR 2 OR 7) AND NOT 3 AND NOT 4 AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.Owner.User_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ZA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Party_Profile.Country_of_Residence__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ZA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.Required_Approval_Processes__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>FAIS Approval Confirmed;</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.Required_Approval_Processes__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Need FAIS Approval;</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.LeadSource</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Direct</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.LeadSource</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Website</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.Sales_Code__r.Sales_Code_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ZA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_for_FAIS_Approval</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This flow automates the FAIS approval process. When an Opportunity tied to an ApplicationForm is in the &quot;Awaiting Signature&quot; stage, the flow checks if FAIS approval is required (based on conditions involving country and existing approval processes). If needed, it updates the Opportunity and sends a notification to the business user (Opportunity Owner) to upload the FAIS document. The flow also logs any errors that occur. SFP-34711

Modification Date:15-10-2025
Modified By: Tushar Walse
Modificaiton Description:
SFP-53780 UAT BUG: Needed improvement on Joint opp with GSD Prohibited country and CASE: GSD Sanctioned and GSD Prohibited in the same application
Reverting to old flow</description>
    <environments>Default</environments>
    <formulas>
        <description>A formula that appends &quot;Need FAIS Approval;&quot; to the processed Required_Approval_Processes__c string along with the Party Profile ID.</description>
        <name>Append_FAIS_Approval_String</name>
        <dataType>String</dataType>
        <expression>{!ReplaceDollarwithSemicolon} + &apos;Need FAIS Approval;&apos; + {!Get_Party_Profile.Id} + &apos;;&apos;</expression>
    </formulas>
    <formulas>
        <description>To send notification to owner</description>
        <name>Notification_Body</name>
        <dataType>String</dataType>
        <expression>{!Retrieve_Custom_Notification_Message.Description__c}+&apos; for &apos;+{!$Record.Account.FirstName}+&apos; &apos;+{!$Record.Account.LastName}</expression>
    </formulas>
    <formulas>
        <description>Formula to replace the $ symbol with a semicolon (;) in the Required_Approval_Processes__c field for consistent formatting.</description>
        <name>ReplaceDollarwithSemicolon</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Opportunity.Required_Approval_Processes__c}), &apos;;&apos;, SUBSTITUTE({!Get_Opportunity.Required_Approval_Processes__c}, &apos;$&apos;, &apos;;&apos;))</expression>
    </formulas>
    <formulas>
        <description>Updated Required Approval Processes Field Value</description>
        <name>UpdatedRequiredApprovalProcessesFieldValue</name>
        <dataType>String</dataType>
        <expression>{!Get_Opportunity.Required_Approval_Processes__c} + &apos;All Applications Signed;&apos;</expression>
    </formulas>
