<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Processes all cases in bulk - updates cases and sends emails</description>
        <name>Bulk_Process_Escalations</name>
        <label>Bulk Process Escalations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>CMN_FLOW_BulkCaseEscalation</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>cases</name>
            <value>
                <elementReference>CasesToEscalate</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>orgWideEmail</name>
            <value>
                <elementReference>Get_UG_PB_Settings.OrgWideEmailAddress__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>templateName</name>
            <value>
                <stringValue>SVC_UG_PB_EscalationNotification</stringValue>
            </value>
        </inputParameters>
        <nameSegment>CMN_FLOW_BulkCaseEscalation</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <description>Logs errors when escalation fails</description>
        <name>Error_Handler</name>
        <label>Error Handler</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>sbgplatform__rflib_LoggerFlowAction</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>context</name>
            <value>
                <stringValue>UG Private Banking Escalation - Error Handler</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>logLevel</name>
            <value>
                <stringValue>ERROR</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>message</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputParameters>
        <nameSegment>sbgplatform__rflib_LoggerFlowAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds case to escalation collection</description>
        <name>Add_Case_To_Collection</name>
        <label>Add Case To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CasesToEscalate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>CurrentCase</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Filter_Cases_Loop</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Validates that automated user was found before processing cases</description>
        <name>Check_Automated_User_Found</name>
        <label>Check Automated User Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>User Not Found</defaultConnectorLabel>
        <rules>
            <name>User_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Automated_User</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_UG_PB_Cases</targetReference>
            </connector>
            <label>User Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if UG PB cases were found</description>
        <name>Check_Cases_Found</name>
        <label>Check Cases Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Cases Found</defaultConnectorLabel>
        <rules>
            <name>Cases_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_UG_PB_Cases</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_Cases_Loop</targetReference>
            </connector>
            <label>Cases Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if any cases are ready for escalation</description>
        <name>Check_Cases_To_Escalate</name>
        <label>Check Cases To Escalate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Cases To Escalate</defaultConnectorLabel>
        <rules>
            <name>Has_Cases_To_Escalate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CasesToEscalate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bulk_Process_Escalations</targetReference>
            </connector>
            <label>Has Cases To Escalate</label>
        </rules>
    </decisions>
    <decisions>
        <description>Validates current case is not null before processing</description>
        <name>Check_Current_Case</name>
        <label>Check Current Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Filter_Cases_Loop</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Case Is Null</defaultConnectorLabel>
        <rules>
            <name>Case_Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CurrentCase</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Escalation_Timing</targetReference>
            </connector>
            <label>Case Not Null</label>
        </rules>
    </decisions>
    <decisions>
        <description>Validates case escalation timing before adding to collection</description>
        <name>Check_Escalation_Timing</name>
        <label>Check Escalation Timing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Filter_Cases_Loop</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Ready</defaultConnectorLabel>
        <rules>
            <name>Ready_for_Escalation</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>CurrentCase.SVC_Escalation_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CurrentCase.LastModifiedById</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Automated_User.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CurrentCase.LastModifiedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>TodayMidnight</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Case_To_Collection</targetReference>
            </connector>
            <label>Ready for Escalation</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if UG PB settings were found</description>
        <name>Check_Settings_Found</name>
        <label>Check Settings Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Settings Not Found</defaultConnectorLabel>
        <rules>
            <name>Settings_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_UG_PB_Settings</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Automated_User</targetReference>
            </connector>
            <label>Settings Found</label>
        </rules>
    </decisions>
    <description>SFP-53263 - UG Email Notifications to Reporting Matrix at Each Escalation Level
Automated escalation matrix for Uganda Private Banking cases with 5-level escalation hierarchy. Escalates cases based on violated SLA milestones from entitlements. Updates escalation fields and sends email notifications.</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns today at midnight to check if case was modified before today</description>
        <name>TodayMidnight</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT(TODAY()) + &quot; 00:00:00&quot;)</expression>
    </formulas>
    <interviewLabel>UG Case Scheduled</interviewLabel>
    <label>UG Case Scheduled</label>
    <loops>
        <description>Filters cases ready for escalation based on timing rules</description>
        <name>Filter_Cases_Loop</name>
        <label>Filter Cases Loop</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>CurrentCase</assignNextValueToReference>
        <collectionReference>Get_UG_PB_Cases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Current_Case</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Cases_To_Escalate</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieves automated user by name for escalation timing validation</description>
        <name>Get_Automated_User</name>
        <label>Get Automated User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Automated_User_Found</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Get_UG_PB_Cases</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_UG_PB_Settings.AutomatedUserName__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves UG Private Banking cases that have violated SLA and need escalation processing</description>
        <name>Get_UG_PB_Cases</name>
        <label>Get UG PB Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Cases_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Handler</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND 3 AND 4 AND 5 AND 6</filterLogic>
        <filters>
            <field>SVC_CaseOwnerTeam__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_UG_PB_Settings.TeamDeveloperName__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Case_Owner_Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>UG</stringValue>
            </value>
        </filters>
        <filters>
            <field>SVC_Escalation_Level__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>Get_UG_PB_Settings.MaxEscalationLevel__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>SVC_Escalation_Level__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>IsEscalated</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>SVC_Escalation_Level__c</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <queriedFields>LastModifiedById</queriedFields>
        <queriedFields>LastModifiedDate</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves UG Private Banking escalation configuration settings from custom metadata</description>
        <name>Get_UG_PB_Settings</name>
        <label>Get UG PB Settings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Settings_Found</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_Handler</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>UG_PB_Escalation</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UG_PB_Escalation_Setting__mdt</object>
        <queriedFields>TeamDeveloperName__c</queriedFields>
        <queriedFields>MaxEscalationLevel__c</queriedFields>
        <queriedFields>OrgWideEmailAddress__c</queriedFields>
        <queriedFields>AutomatedUserName__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_UG_PB_Settings</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-02-02</startDate>
            <startTime>05:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>Collection of cases ready for escalation</description>
        <name>CasesToEscalate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <description>Current case being processed in loop</description>
        <name>CurrentCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
</Flow>
