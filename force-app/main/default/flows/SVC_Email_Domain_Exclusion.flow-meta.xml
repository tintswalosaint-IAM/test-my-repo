    <decisions>
        <name>Check_Domain_Match</name>
        <label>Check Domain Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Blocked_Domains</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Check_Domain_Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Blocked_Domains.CMN_SBG_Domain_Name__c</leftValueReference>
                <operator>EqualTo</operator>
