                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Ins_Client_Email_Address</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Domain_Exclusion_Indicator</targetReference>
            </connector>
            <label>Outcome 1 of Check Domain Match</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Domain_Exclusion_Enabled</name>
        <label>Is Domain Exclusion Enabled?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Is_Domain_Exclusion_Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Ins_Internal_Domain_Exclusion</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Custom_Metadata</targetReference>
            </connector>
            <label>Outcome 1 of Is Domain Exclusion Enabled?</label>
        </rules>
    </decisions>
    <description>SFP-56297
Updated survey logic to exclude internal SBSA email addresses from receiving NPS surveys.</description>
    <environments>Default</environments>
    <formulas>
        <name>Ins_Get_Client_Email_Domain_Name</name>
        <dataType>String</dataType>
        <expression>LOWER(
    RIGHT(
        {!Ins_Client_Email_Address},
        LEN({!Ins_Client_Email_Address}) -
        FIND(&quot;@&quot;, {!Ins_Client_Email_Address}) + 1
    )
)</expression>
    </formulas>
    <interviewLabel>SVC_Email_Domain_Exclusion {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SVC_Email_Domain_Exclusion</label>
