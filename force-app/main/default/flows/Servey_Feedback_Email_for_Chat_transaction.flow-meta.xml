    <decisions>
        <name>Check_IF_Case_is_Present_or_Not</name>
        <label>Check IF Case is Present or Not</label>
        <locationX>314</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>IF_Case_is_not_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Case.Case_Owner_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Servey_Email_Alert</targetReference>
            </connector>
            <label>IF Case is not NULL</label>
        </rules>
        <rules>
            <name>IF_Case_Null</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CaseId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LiveChatButton.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LS_CCC_Chat</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LiveChatButton.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LS_CCC_LiveChat</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Generic_Survey</targetReference>
            </connector>
            <label>IF Case Null</label>
        </rules>
    </decisions>
    <description>sending an survey link for chat transaction users</description>
