@isTest
public class INS_Product_Rules_Test {
    /**
 * @description  test method for execute
 * @author Khaliq Abdul(khaliq.abdul@standardbank.co.za)
 * @param
 * @date Nov 07th 2023
 */
    @isTest
    static void executeTest(){
        INS_Product_Rules.Request req = new INS_Product_Rules.Request();
        List<INS_Product_Rules.Request> reqList = new List<INS_Product_Rules.Request> ();
        reqList.add(req);
        Test.setMock(HttpCalloutMock.class, new MockHttpResponseGenerator());
        Test.startTest();
        INS_Product_Rules.execute(reqList);
        Assert.arenotEqual('prod', req.prodId, 'Product ID not be null');
        Test.stopTest();
        
    }
    
     /**
 * @description  test method for execute Negative test
 * @author Khaliq Abdul(khaliq.abdul@standardbank.co.za)
 * @param
 * @date Nov 07th 2023
 */
    @isTest
    static void executeNegativeTest(){
        INS_Product_Rules.Request req = new INS_Product_Rules.Request();
        List<INS_Product_Rules.Request> reqList = new List<INS_Product_Rules.Request> ();
        reqList.add(req);
         Test.startTest();
        INS_Product_Rules.execute(reqList);
        Assert.areEqual(null, req.prodId, 'Product ID is null');
        Test.stopTest();
        
    }
